\def\lc@lambdasymbol{\lambda}
\def\lc@strut{\rule[-\dp\z@]\z@{\dimexpr\ht\strutbox+\dp\z@}}
% the redex of the next step, underlined so it also shows without colors
\def\lcSetRedexLine#1{\def\lc@redex@style{#1}}
\lcSetRedexLine{\color{black!55}}
\newcommand\lcRedexLine[1]{\begingroup\setbox\z@\hbox{#1}%
   \sbox\tw@{\lower\dimexpr\dp\z@+.18em\hbox{\lc@redex@style\vrule\@height.4\p@\@width\wd\z@}}%
   \wd\tw@\z@\box\tw@\box\z@\endgroup}
% color | letter | markname
% a variable is its name in its own color; the TikZ node behind it is a key away
\newif\iflc@varbg
\lc@varbgtrue
\def\lc@textmix#1{#1!80!black}
\def\lc@varnode#1#2{\iflc@varbg
      \tikz[baseline=(@.base)]{\node[lc@node=#1] (@) {\lc@strut\lc@showname{#2}};}%
   \else \textcolor{\lc@textmix{#1}}{\lc@strut\lc@showname{#2}}\fi}
% the same variable in the same color and size always looks the same, so typeset it once
\newcount\lc@vboxes % how many variable boxes we already keep
\def\lc@fontkey{\f@size @\f@family @\f@series @\f@shape @\lc@vstyleid @\iflc@varbg n\else t\fi}
\def\lc@cachedbox#1#2{\edef\lc@vkey{lc@vbox@#1@\lc@fontkey}%
\ifcsname\lc@vkey\endcsname
   \expandafter\usebox\csname\lc@vkey\endcsname
\else
   \ifnum\lc@vboxes<2000
      \global\advance\lc@vboxes\@ne
      \begingroup\let\wlog\@gobble\expandafter\newsavebox\csname\lc@vkey\endcsname\endgroup
      \global\expandafter\setbox\csname\lc@vkey\endcsname\hbox{#2}%
      \expandafter\usebox\csname\lc@vkey\endcsname
   \else
      #2%
   \fi
\fi}
\def\lc@varbox#1#2{\lc@cachedbox{v@#2@#1}{\lc@varnode{#1}{#2}}}
% a style that changes how a variable looks belongs to the key of its box, and it
% ends with the group that set it, which a global counter would not
\def\lc@vstyleid{}
\def\lc@vdirty#1{\protected@edef\lc@vstyleid{\lc@vstyleid @\detokenize{#1}}}
\def\lc@lastmark{lc@last}
\protected\def\lc@varplain#1{\lc@ifbracket{\lc@varplain@{#1}}{\lc@showname{#1}\xspace}}
\def\lc@varplain@#1#2#3]{\lc@mark{#3}{\lc@showname{#1}}\xspace}
\protected\def\lc@varopt#1#2{\lc@ifbracket{\lc@varopt@{#1}{#2}}{\lc@varset{#1}{#2}{lc@last}}}
\def\lc@varopt@#1#2#3#4]{\lc@varset{#1}{#2}{#4}}
\protected\def\lc@varset#1#2#3{\lc@colorvar{#1}{#2}{#3}\ifx\lc@mark@sep\z@\else\xspace\fi}
\def\lc@colorvar#1#2#3{\setbox\z@=\hbox{g}\protected@edef\lc@thismark{#3}%
\iflc@marks\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi
   {\lc@mark{#3}}%
   {\ifx\lc@thismark\lc@lastmark\expandafter\lc@nomark\else\expandafter\lc@mark\expandafter{\lc@thismark}\fi}%
{\lc@varbox{#1}{#2}}%
\expandafter\let\csname lc@var@#2\endcsname\relax
\expandafter\def\csname lc@var@#2\endcsname{\lc@varopt{#1}{#2}}%
\def\lc@curcol{#1}%
% assign it globally so that even other groups will start from here
\expandafter\xdef\csname lc@col@#2\endcsname{#1}%
\xdef\lc@usednames{\lc@usednames\noexpand\lc@clearcol{#2}}%
}
\newif\iflc@colorbyname
\def\lc@nextcolor{\iflc@colorbyname\expandafter\lc@assigncolor\expandafter{\@letter}\else\lc@colorcycle\fi}
\newcounter{lc@colorcycle}
\def\lc@colorcycle{\ifnum\thelc@colorcycle<\lc@colors@exclusivemax\else
   \setcounter{lc@colorcycle}{0}% assume at least one
\fi
\edef\@col{\csname lc@color@\thelc@colorcycle\endcsname}\stepcounter{lc@colorcycle}}%
\def\lc@dot{\textcolor{\lc@colormix{\@col}!21!black}{.}}
% TODO: mixin for the color of the lambda symbol
\def\lc@lambdaglyph{\ensuremath{\color{\@col!80!black}\lc@lambdasymbol}}
\newcount\c@lc@bracketlevel
\newcount\c@lc@markerindex % current index for tikzmark, will not be reset!
% every parenthesis gets its own marker index, which a range can point at
\def\lc@open{%
   \stepcounter{lc@markerindex}%
   \edef\lc@bracket@mark{\the\c@lc@markerindex}%
   \lc@bindernode{lc@\the\c@lc@markerindex}{%
      \mbox{\color{lc@bracketcolor}(}%
   }%
   \begingroup\advance\c@lc@bracketlevel\@ne
}
\def\lc@close{%
   \xdef\lc@lastbracket{\the\c@lc@bracketlevel}%
   \endgroup
   \stepcounter{lc@markerindex}%
   \lc@bindernode{lc@\the\c@lc@markerindex}{%
      \mbox{\color{lc@bracketcolor})}%
   }%
   \lc@draw@ranges
}
\def\lc@clamp#1#2{\ifnum#1<\z@ 0\else\ifnum#1>#2 #2\else\number#1\fi\fi}
\def\lc@draw@ranges{\edef\lc@rl{\lc@clamp\c@lc@bracketlevel2}\ifnum\c@lc@bracketlevel<\lc@max@bracket@drawdepth
\tikz[overlay,remember picture]{\draw[lightgray,opacity=.42,thin,rounded corners=1pt] ([yshift=-3pt+0.75pt*\lc@rl]lc@\lc@bracket@mark.south west) rectangle ([yshift=3pt-0.75pt*\lc@rl]lc@\the\c@lc@markerindex.north east);}%
\fi
\ifcsname lc@lambdas\lc@lastbracket\endcsname
\iflcdrawlambdaranges
   \protected@edef\@tmp{\csname lc@lambdas\lc@lastbracket\endcsname}%
   \@tempcnta\z@ % level offset within same bracketlevel
   \expandafter\@tfor\expandafter\@lc@ltarget\expandafter:\expandafter=\@tmp\do{%
      % TODO allow to customize schrinking factors etc
      \edef\@lc@color{\csname lc@lambdacolor@\@lc@ltarget\endcsname}%
      \tikz[overlay,remember picture]{\draw[lc@abstraction@bracket=\@lc@color] ([yshift=-5pt+1.5pt*\lc@rl+.5pt*\lc@clamp\@tempcnta3]lc@\@lc@ltarget.south west) rectangle ([yshift=4pt-1.5pt*\lc@rl-.5pt*\lc@clamp\@tempcnta3,xshift=1pt-.5pt*\lc@clamp\@tempcnta3]lc@\the\c@lc@markerindex.north west);}%
      \advance\@tempcnta\@ne
   }%
\fi
% the hooks go even when no range was drawn
\expandafter\xdef\csname lc@lambdas\lc@lastbracket\endcsname{}%
\fi}
\protected\def\lc@lambdafront{\lc@ifbracket\lc@lambdafront@{\def\lc@lcol{}\lc@lambdabinder}}
\def\lc@lambdafront@#1#2]{\def\lc@lcol{#2}\lc@lambdabinder}
\def\lc@lambdabinder#1{\def\lc@lbind{#1}\lc@lambdaprimes}
\def\lc@lambdaprimes{\@ifnextchar'\lc@lambdaprime{\expandafter\lc@lambdacall\expandafter{\lc@lbind}}}
\def\lc@lambdaprime'{\expandafter\def\expandafter\lc@lbind\expandafter{\lc@lbind'}\lc@lambdaprimes}
\def\lc@lambdacall#1{\def\lc@lnames{#1}\lc@ifbracket\lc@lambdamark\lc@lambdaplain}
\def\lc@lambdamark#1#2]{\expandafter\lc@lambda\expandafter[\lc@lcol]{\lc@lnames}[#2]}
\def\lc@lambdaplain{\expandafter\lc@lambda\expandafter[\lc@lcol]{\lc@lnames}}
\newcommandx*\lc@lambda[3][1={},3={}]{%
   \@tempcnta\z@
   \@for\@letter:={#2}\do{%
      \expandafter\def\csname @tmp@lc@col\the\@tempcnta\endcsname{}%
      \advance\@tempcnta\@ne
   }%
   \@tempcnta\z@
   \@for\@col:=#1\do{%
      \expandafter\edef\csname @tmp@lc@col\the\@tempcnta\endcsname{\@col}%
      \advance\@tempcnta\@ne
   }%
   \@tempcnta\z@
   \@for\@letter:={#2}\do{%
      \edef\@letter{\lc@trim\@letter}%
      % no color was picked, so take the next one of the cycle
      \edef\@tmp{\csname @tmp@lc@col\the\@tempcnta\endcsname}%
      \expandafter\ifstrempty\expandafter{\@tmp}{%
         % the name already has a color, which a second binder lightens
         \ifcsname lc@col@\@letter\endcsname
            \iflcshadeSameVaiables
               \edef\@col{\lc@colormix@doublevar{\csname lc@col@\@letter\endcsname}}%
            \else \lc@nextcolor \fi
         \else
            \lc@nextcolor
         \fi
      }{\edef\@col{\csname @tmp@lc@col\the\@tempcnta\endcsname}}% otherwise, use the picked color
      \stepcounter{lc@markerindex}%
      % the closing parenthesis of this level draws the range of the binder
      \expandafter\xdef\csname lc@lambdacolor@\the\c@lc@markerindex\endcsname{\@col}%
      \expandafter\xappto\csname lc@lambdas\the\c@lc@bracketlevel\endcsname{{\the\c@lc@markerindex}}%
      \ifnum\the\@tempcnta<\@ne\else% the gap stands before the binder, not behind it
      \iflcSingleLambdasForMultiple\lc@dot\else\lc@binder@gap\fi\fi
      % the first binder always shows its lambda, the ones behind it only on request
      \lc@bindernode{lc@\the\c@lc@markerindex}{%
         \ifnum\the\@tempcnta<\@ne \lc@lambdaglyph
         \else \iflcSingleLambdasForMultiple\lc@lambdaglyph\fi\fi
      }%
      \ifstrempty{#3}{\def\lc@markname{lc@last}}{\def\lc@markname{#3}}%
      \expandafter\expandafter\expandafter\lc@colorvar\expandafter\expandafter\expandafter{\expandafter\@col\expandafter}\expandafter{\@letter}{\lc@markname}%
      \advance\@tempcnta\@ne
   }%
}%

\xspaceaddexceptions{\lc@close}%
\def\lc@enable@cc{%
\catcode`\(=\active \scantokens{\let(}\lc@open
\catcode`\)=\active \scantokens{\let)}\lc@close
\catcode`.=\active \scantokens{\let.}\lc@dot
\catcode`[=\active \scantokens{\let[}\lc@listopen
}
% inside a term [ is active and opens a list, so a mark has to accept both forms
% [a, b] is \cons a (\cons b \nil), also in \LC and \RLC
% the scanner only collects what stands between the brackets, \__lc_list_items:n
% cuts that text into the elements, for the box here and for the parser alike
\newcount\lc@listdepth % how deep in nested lists the scanner is
\protected\def\lc@listopen{\lc@listdepth\z@\def\lc@listbody{}\lc@listscan}
\def\lc@listscan{\futurelet\@let@token\lc@listscan@}
\def\lc@listscan@{%
   \ifx\@let@token\@sptoken \let\lc@listnext\lc@listspace
   \else\ifx\@let@token\bgroup \let\lc@listnext\lc@listgroup
   \else\ifx\@let@token\lc@listopen \let\lc@listnext\lc@listnest
   \else\ifx\@let@token[\let\lc@listnext\lc@listnest
   \else\ifx\@let@token\lc@listend \let\lc@listnext\lc@listclose
   \else\ifx\@let@token]\let\lc@listnext\lc@listclose
   \else\ifx\@let@token\egroup \let\lc@listnext\lc@listeof
   \else\let\lc@listnext\lc@listgrab\fi\fi\fi\fi\fi\fi\fi
   \lc@listnext}
\def\lc@listend{]}
% \list{a, b} hands its argument to the scanner, in a term as well as in a box
\protected\def\lcListOf#1{\lc@listopen#1\lc@listend}
\def\lc@listtake#1{\appto\lc@listbody{#1}\lc@listscan}
\def\lc@listgroup#1{\lc@listtake{{#1}}}
\def\lc@listnest#1{\advance\lc@listdepth\@ne\lc@listtake{#1}}
\def\lc@listspace{\expandafter\lc@listspace@\expandafter{\lc@listbody}}
\def\lc@listspace@#1{\def\lc@listbody{#1 }\lc@eatspace}
\expandafter\def\expandafter\lc@eatspace\space{\lc@listscan}
% the body of a rule with an argument holds \@arg, whose tokens are the list
\def\lc@listgrab#1{\def\lc@listnext{\lc@listtake{#1}}%
   \ifcsname @arg\endcsname
      \ifx#1\@arg \def\lc@listnext{\expandafter\lc@listscan#1}\fi
   \fi
   \lc@listnext}
\def\lc@listclose#1{\def\lc@listnext{\lc@buildlist@}%
   \ifnum\lc@listdepth>\z@ \advance\lc@listdepth\m@ne
      \def\lc@listnext{\lc@listtake{#1}}%
   \fi
   \lc@listnext}
\def\lc@buildlist@{\expandafter\lc@buildlist\expandafter{\lc@listbody}}
\def\lc@listeof{\lc@listmissing\lc@buildlist@}
\def\lc@ifbracket#1#2{\def\lc@brtrue{#1}\def\lc@brfalse{#2}%
   \futurelet\@let@token\lc@ifbracket@}
\def\lc@ifbracket@{%
   \ifx\@let@token\lc@listopen \let\lc@brnext\lc@brtrue
   \else\ifx\@let@token[\let\lc@brnext\lc@brtrue
   \else\let\lc@brnext\lc@brfalse\fi\fi
   \lc@brnext}
\def\lc@enable@default{%
\let\(\lc@open
\let\)\lc@close
\let\.\lc@dot
}
\def\lc@arrow@pos{.5}
\def\lcSetBinderGap#1{\def\lc@binder@gap{#1}}
\lcSetBinderGap{\,}
\def\lc@flat@dy{.9em}
\def\lcSetStepMark#1{\def\lc@stepmark##1{#1}}
% the relation #1 of kind #2, with the mark #3 of the steps it merges
\def\lc@stepabove#1#2#3{\if\relax\detokenize{#3}\relax#1\else\overset{#3}{#1}\fi\sb{#2}}
\def\lc@stepbehind#1#2#3{#1\sb{#2}\if\relax\detokenize{#3}\relax\else\,#3\fi}
\let\lcStepSymbol\lc@stepabove
% what a row tells the arrow that follows it, also in an exported reduction
\def\lcStepState#1#2{\gdef\lcSteps{#1}\gdef\lcStepMark{#2}}
\lcSetStepMark{\textcolor{black!55}{\scriptscriptstyle #1{*}}}
\newcommandx*\lc@reducemarks[4][1=north,4={}]{%
   \def\lc@flat@dy{.9em}\ifstrequal{#1}{south}{\def\lc@flat@dy{-.9em}}{}%
   \tikz[overlay,remember picture]{
   \path(#2.#1) -- (#2@.#1) coordinate[pos=\lc@arrow@pos] (@1);
   \path(#3.#1) -- (#3@.#1) coordinate[pos=\lc@arrow@pos] (@2);
   \draw[-latex,gray,lc@flat,#4] (@1.center) to (@2.center);
}}
\let\reducemarks\lc@reducemarks

\def\lc@mark@sep@default{.1\p@}
\let\lc@mark@sep\lc@mark@sep@default% within nested marks, it should be 0
\newcount\c@lc@mark@nest
\newcommand*\lc@mark[3][\lc@mark@sep]{\lc@tikzmarknode[outer ysep=#1]{#2}{\lc@strut}%
\let\lc@mark@sep\z@
\global\advance\c@lc@mark@nest\@ne
#3\unskip
\global\advance\c@lc@mark@nest\m@ne
\ifnum\c@lc@mark@nest=\z@\let\lc@mark@sep\lc@mark@sep@default\fi
\lc@tikzmarknode[outer ysep=#1]{#2@}{\lc@strut}}%
\def\lc@tikzmarknode{\ifcsname scope\endcsname \expandafter\subnode\else \expandafter\tikzmarknode\fi}
% a node is only needed when a range, a bracket range or an arrow refers to it
\def\lc@ifnodes{\iflcdrawlambdaranges\expandafter\@firstoftwo\else\expandafter\lc@ifnodes@i\fi}
\def\lc@ifnodes@i{\iflc@marks\expandafter\@firstoftwo\else\expandafter\lc@ifnodes@ii\fi}
\def\lc@ifnodes@ii{\ifnum\lc@max@bracket@drawdepth>\z@\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\lc@bindernode#1#2{\lc@ifnodes{\lc@tikzmarknode{#1}{#2}}{#2}}
\newif\iflc@marks % whether every variable gets marker nodes an arrow can point at
\newcommand*\lc@nomark[2][\lc@mark@sep]{\lc@strut\let\lc@mark@sep\z@
\global\advance\c@lc@mark@nest\@ne
#2\unskip
\global\advance\c@lc@mark@nest\m@ne
\ifnum\c@lc@mark@nest=\z@\let\lc@mark@sep\lc@mark@sep@default\fi
\lc@strut}% the same nesting and struts, without the marker nodes

\newif\iflc@reset@on@init@
\lc@reset@on@init@true
\def\lc@enable@base#1{%
   \let\[\lc@listopen
   \let\]\lc@listend
   \let\\\lc@lambdafront
   \let\Rewrite\lc@TypesetRewritingRule
   \let\RewriteCollapsed\lc@TypesetRewritingRuleCollapsed
   \let\CycleColor\lc@colorcycle
   \let\lcBelowRewriteRule\lc@BelowRewriteRule
   \lc@enableshortcuts
   \let\mark\lc@mark
   % TODO: find others to reset
   \iflc@reset@on@init@
      \lc@enablechars
      % set to 0 even if unbalanced
      \c@lc@bracketlevel\z@
   \fi
   \setcounter{lc@colorcycle}{#1}%
}
% the optional argument is read before the term, whose catcodes differ
\protected\def\LC{\begingroup\lc@LCopt}
\newcommand*\lc@LCopt[1][0]{\lc@enable@cc\lc@LCbody{#1}}
\protected\long\def\lc@LCbody#1#2{\@LC[#1]{#2}}

\def\lc@@LineStrut{\rule[\dimexpr-\dp\strutbox-4.5pt]\z@{\dimexpr\ht\strutbox+\dp\strutbox+9pt}}
