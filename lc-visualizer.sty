% a macro per letter, so nothing has to be made active for a variable
\def\lc@enablechars{\@for\@l:={a,b,c,d,e,f,g,h,i,j,k,l,m,n,o,p,q,r,s,t,u,v,w,x,y,z}\do{%
   \expandafter\lc@defletter\expandafter{\@l}%
}\lc@usednames\gdef\lc@usednames{}}%
\def\lc@usednames{}
% only the names that were colored need undoing; the rest are built on first use
\def\lc@clearcol#1{\csgundef{lc@col@#1}\csgundef{lc@var@#1}}
\def\lc@defletter#1{\expandafter\def\csname#1\endcsname{\lc@var{#1}}}
% the parser has to know the name as well, or it would read the macro as a constant
\def\lc@enableletter#1{\lc@defletter{#1}\lc@enablechar{#1}\csgdef{lc@enabled@#1}{}}
\def\lc@enablechar#1{%
   \expandafter\def\csname lc@var@#1\endcsname{\lc@varplain{#1}}%
   \csgundef{lc@col@#1}% clear global colordef
}
\protected\def\lc@var#1{\@ifnextchar'{\lc@var@prime{#1}}{\lc@usevar{#1}}}
\def\lc@var@prime#1'{\lc@var{#1'}}
\protected\def\lc@usevar#1{\ifcsname lc@var@#1\endcsname\else\expandafter\def\csname lc@var@#1\endcsname{\lc@varplain{#1}}\fi\csname lc@var@#1\endcsname}
\def\lc@showname#1{\if\relax\detokenize{#1}\relax\else\lc@shown#1\@nil\fi}
\def\lc@shown#1#2\@nil{#1\ifx'#1\kern\z@\fi\ifx\relax#2\relax\else\lc@shown#2\@nil\fi}
\let\lcEnableChar\lc@enableletter

