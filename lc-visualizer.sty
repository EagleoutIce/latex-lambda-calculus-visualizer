   \lcCreateNewRewritingRule\tail{tail}{\\{d}\.\d \false}%
   \lcCreateNewRewritingRule\nil{nil}{\\x\.\true}%
   \lcCreateNewRewritingRule\ListNull{null}{\\d\.\d \(\\{x,y}\.\false\)}%
   \lcLoadModule{nat,comb}%
   \lcCreateNewRewritingRule\length{length}{\Ycomb \(\\{r,l}\.\ifelse \(\ListNull \l\) \num{0} \(\succ \(\r \(\tail \l\)\)\)\)}%
   \lcCreateNewRewritingRule\ListSum{sum}{\Ycomb \(\\{r,l}\.\ifelse \(\ListNull \l\) \num{0} \(\add \(\head \l\) \(\r \(\tail \l\)\)\)\)}%
   \lcCreateNewRewritingRule\ListProd{prod}{\Ycomb \(\\{r,l}\.\ifelse \(\ListNull \l\) \num{1} \(\mult \(\head \l\) \(\r \(\tail \l\)\)\)\)}%
   \lcCreateNewRewritingRule\ListContains{contains}{\Ycomb \(\\{r,n,l}\.\ifelse \(\ListNull \l\) \false \(\ifelse \(\eq \n \(\head \l\)\) \true \(\r \n \(\tail \l\)\)\)\)}%
