\cs_new_protected:Npn \__lc_run:nnn #1#2#3 % the common driver of all the user commands
  {
    \group_begin:
      \keys_set:nn { lc-visualizer } {#1}
      \bool_if:nT { ( \mode_if_horizontal_p: && \mode_if_inner_p: ) || \mode_if_math_p: }
        { \str_set:Nn \l__lc_layout_str { inline } }
      \__lc_set_style:
      \bool_set:Nn \l__lc_store_bool
        { \str_if_eq_p:nn {#3} { \__lc_typeset_reduction: } || \l__lc_tooltips_bool || ! \str_if_empty_p:N \l__lc_export_str }
      \__lc_digests:
      \str_set:Ne \l__lc_hash_str
        {
          \str_mdfive_hash:e
            {
              \use:c { ver@lc-visualizer.sty } | \tl_to_str:n { #2 | #3 } | \__lc_state: | \g__lc_rules_str
            }
        }
      % the rule boxes of one reduction look alike, those of two do not have to
      \int_gincr:N \g__lc_reduction_int
      \cs_set:Npx \lc@rulebox@salt { \int_use:N \g__lc_reduction_int }
      \seq_clear:N \l__lc_out_seq
      \prop_gclear:N \g__lc_colors_prop
      \int_gzero:N \g__lc_colors_int
      \bool_lazy_and:nnTF { \tl_if_empty_p:n {#3} } { \str_if_empty_p:N \l__lc_export_str }
        { \__lc_reduce:n {#2} }
        {
          \bool_lazy_and:nnTF
            { \cs_if_exist_p:c { g__lc_memo_ \l__lc_hash_str _tl } }
            { \str_if_empty_p:N \l__lc_export_str }
            { \tl_use:c { g__lc_memo_ \l__lc_hash_str _tl } }
            {
              \bool_lazy_or:nnTF
                { \str_if_empty_p:N \l__lc_cache_str } { ! \str_if_empty_p:N \l__lc_export_str }
                { \__lc_compute:nn {#2} {#3} }
                { \__lc_cached:nn {#2} {#3} }
              \str_if_empty:NF \l__lc_export_str { \__lc_export: }
            }
        }
    \group_end:
  }
