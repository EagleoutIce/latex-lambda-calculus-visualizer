\newcount\c@lc@current@rewriteexpansiondepth

\def\lc@rewrite@name@strut{}

% TODO: bracket/lambda range highlighter within rewrite rules (i.e. like closing brace)
% cs | name | rewrite rules
\def\lcCreateNewRewritingRule#1#2#3{\lc@register@rule{#1}{#3}\gappto\lc@enableshortcuts{\def#1{\@ifstar{\lc@TypesetRewritingRuleCollapsed{#2}\xspace}{\ifnum\c@lc@current@rewriteexpansiondepth<\lc@max@rewriting@rule@expanddepth \lc@TypesetRewritingRule{#2}{#3}\else \lc@TypesetRewritingRuleCollapsed{#2}\fi\xspace}}}}

\def\lcCreateNewArgumentRewritingRule#1#2#3{\lc@register@rule{#1}{#3}\expandafter\gdef\csname lc@argrule@\expandafter\@gobble\string#1\endcsname{}\csgundef{lc@rawargrule@\expandafter\@gobble\string#1}\gappto\lc@enableshortcuts{\def#1{\@ifstar{\def\lc@second{#2}\lc@TypesetArgumentRewritingRuleCollapsed}{\def\lc@second{#2}\def\lc@third{#3}\lc@TypesetArgumentRewritingRule}}}}

% the argument of such a rule reaches its body as it was written, not as a term
\def\lcRawArgumentRule#1{\csgdef{lc@rawargrule@\expandafter\@gobble\string#1}{}}
\def\lc@TypesetArgumentRewritingRuleCollapsed#1{\def\@arg{#1}\let\lcArg\@arg\lc@TypesetRewritingRuleCollapsed{\lc@second}\xspace}
\def\lc@TypesetArgumentRewritingRule#1{\def\@arg{#1}\let\lcArg\@arg\ifnum\c@lc@current@rewriteexpansiondepth<\lc@max@rewriting@rule@expanddepth  \lc@TypesetRewritingRule{\lc@second}{\lc@third}\else \lc@TypesetRewritingRuleCollapsed{\lc@second}\fi\xspace}

% TODO: lambda vis intent resets within nestings
\usetikzlibrary{shapes.multipart}
\def\lc@rewrite@inner@strut{\rule[\dimexpr-\dp0-\lc@rewrite@inner@strut@lower]{0pt}{\dimexpr\dp0+\ht0+\lc@rewrite@inner@strut@upper+\lc@rewrite@inner@strut@lower}}
% upper | lower
\def\lc@rewrite@inner@strut@upper{1pt}\def\lc@rewrite@inner@strut@lower{1pt}

% the same rule, in the same colors, looks the same in every row of a reduction
\def\lc@rulebox@salt{}
\newif\iflc@inrulename % inside the name of a rule, where a nested rule is only text
\def\lc@rulename#1{\begingroup\lc@inrulenametrue#1\unskip\endgroup}
% the strut around the name is part of the look, so it belongs to the key of the box
\def\lc@strutkey{\detokenize\expandafter{\lc@rewrite@name@strut}}
\def\lc@TypesetRewritingRule#1#2{\iflc@inrulename\lc@rulename{#1}\else\iflc@colorbyname
   \ifx\lc@rulebox@salt\@empty\lc@TypesetRewritingRule@{#1}{#2}\else
   \iflcdrawlambdaranges\lc@TypesetRewritingRule@{#1}{#2}\else
   \iflc@marks\lc@TypesetRewritingRule@{#1}{#2}\else
   \ifnum\lc@max@bracket@drawdepth>\z@\lc@TypesetRewritingRule@{#1}{#2}\else
   \protected@edef\lc@boxname{#1}\edef\lc@boxname{\detokenize\expandafter{\lc@boxname}}%
   \lc@cachedbox{R@\lc@boxname @\lc@strutkey @\lc@rulebox@salt}{\lc@TypesetRewritingRule@{#1}{#2}}\fi\fi\fi\fi
   \else\lc@TypesetRewritingRule@{#1}{#2}\fi\fi}
\def\lc@TypesetRewritingRule@#1#2{\global\advance\c@lc@current@rewriteexpansiondepth\@ne\setbox0=\hbox{\lc@reset@on@init@false\advance\c@lc@bracketlevel\@ne\RLC[\the\c@lc@colorcycle]{#2}\stepcounter{lc@markerindex}\lc@bindernode{lc@\the\c@lc@markerindex}{\lc@strut}\expandafter\xdef\csname lc@lambdas\the\c@lc@bracketlevel\endcsname{}}\tikz[baseline=(@.two)]{\node[lc@node@replacement,inner ysep=.5pt,inner xsep=2pt] (@) {\scriptsize\lc@rewrite@name@strut\lc@rulename{#1}\nodepart{two}\lc@rewrite@inner@strut\box0};}\global\advance\c@lc@current@rewriteexpansiondepth\m@ne}

\def\lc@BelowRewriteRule#1#2{\global\advance\c@lc@current@rewriteexpansiondepth\@ne\setbox0=\hbox{\lc@reset@on@init@false\advance\c@lc@bracketlevel\@ne\RLC[\the\c@lc@colorcycle]{#2}\stepcounter{lc@markerindex}\lc@bindernode{lc@\the\c@lc@markerindex}{\lc@strut}\expandafter\xdef\csname lc@lambdas\the\c@lc@bracketlevel\endcsname{}}\tikz[baseline=(@.base)]{\node[lc@node@replacement@inv,inner ysep=.5pt,inner xsep=2pt] (@) {\lc@rewrite@inner@strut\box0\nodepart{two}\scriptsize\lc@rewrite@name@strut\lc@rulename{#1}};}\global\advance\c@lc@current@rewriteexpansiondepth\m@ne}

\def\lc@TypesetRewritingRuleCollapsed#1{\iflc@inrulename\lc@rulename{#1}\else
   \protected@edef\lc@boxname{#1}%
   \edef\lc@boxname{\detokenize\expandafter{\lc@boxname}}%
   \lc@cachedbox{r@\lc@boxname @\lc@strutkey}%
   {\tikz[baseline=(@.base)]{\node[lc@node@replacement@collapsed] (@) {\lc@rewrite@name@strut\lc@rulename{#1}};}}\fi}

\def\lc@rule@names{}
\def\lc@register@rule#1#2{\global\lc@rulesdirtytrue\lc@clearfoldcache%
   \lc@checkrulename{\expandafter\@gobble\string#1}%
   \expandafter\gdef\csname lc@rule@body@\expandafter\@gobble\string#1\endcsname{#2}%
   \xdef\lc@rule@names{\lc@rule@names{\expandafter\@gobble\string#1}}}

% A term is a triple {v}{<name>}{}, {l}{<name>}{<body>}, {a}{<fun>}{<arg>} or {c}{<tokens>}{<term>}:
% a constant typeset as <tokens> that binds like the unfolded rule <term> (empty for other macros).
\ExplSyntaxOn

\tl_new:N \g__lc_in_tl % the token stream the parser still has to read
\tl_new:N \g__lc_start_tl % the term as parsed, before any reduction
\tl_new:N \g__lc_ret_tl % where the recursive helpers hand back a term
\tl_new:N \g__lc_new_tl % the term after the step that was just found
\tl_new:N \g__lc_marked_tl % the same step, with its redex marked for typesetting
\tl_new:N \g__lc_result_tl % the final term of the reduction
\tl_new:N \l__lc_acc_tl % application built up while parsing a sequence
\tl_new:N \l__lc_head_tl % the token currently at the front of the input
\tl_new:N \l__lc_text_lambda_tl % how the plain text of a term writes the binder
\tl_new:N \l__lc_symbol_width_tl % the width the relation of a row is set to
\tl_new:N \l__lc_row_sep_tl % the space between two rows
\tl_new:N \l__lc_saved_in_tl % saves the outer input across a nested parse
\tl_new:N \l__lc_tmp_tl % scratch term
\tl_new:N \l__lc_term_tl % the term the reducer is currently working on
\seq_new:N \l__lc_out_seq % the typeset rows, collected before output
\str_new:N \l__lc_name_str % the variable or rule name being read
\str_new:N \l__lc_new_str % the fresh name a renaming binds to
\str_new:N \g__lc_kind_str % which kind of step was found, empty if none
\str_new:N \g__lc_fresh_str % candidate fresh name while avoiding capture
\str_new:N \l__lc_layout_str % lines or inline, how the rows are laid out
\seq_new:N \g__lc_names_seq % names collected while walking a term
\seq_new:N \g__lc_avoid_seq % names a fresh variable must not clash with
\int_new:N \g__lc_steps_int % how many steps the last reduction took
\bool_new:N \g__lc_avoid_bool % whether the avoid list is already built
\bool_new:N \l__lc_store_bool % whether every step has to be kept for output
\seq_new:N \g__lc_shown_seq % the steps that actually became a row
\seq_new:N \l__lc_bound_seq % binders in scope while collecting free names
\seq_new:N \l__lc_fvN_seq % free names the argument brings into the body
\seq_new:N \l__lc_binders_seq % the binders of one abstraction, in order
\seq_new:N \l__lc_unfolding_seq % rules being unfolded, to catch recursion
\tl_new:N \l__lc_arg_tl % the argument handed to a rewriting rule
\clist_new:N \l__lc_binders_clist % the binder list of an abstraction before splitting
\bool_new:N \l__lc_continue_bool % keeps the atom loop of a sequence running
\bool_new:N \l__lc_loop_bool % keeps the reduction loop running
\bool_new:N \g__lc_renamed_bool % set when a step had to rename, i.e. alpha
\bool_new:N \g__lc_nf_bool % whether a normal form was actually reached
\bool_new:N \l__lc_eta_bool % option: allow eta steps
\bool_new:N \l__lc_delta_bool % option: allow delta steps, unfolding rules
\bool_new:N \l__lc_arrows_bool % option: draw the arrow from argument to binder
\int_new:N \l__lc_max_int % the max-steps limit for one reduction
\int_new:N \l__lc_count_int % steps done so far, also reused for counting
\int_new:N \l__lc_mark_int % per-row counter making the tikz marks unique
\str_const:Ne \c__lc_bs_str { \c_backslash_str }
\regex_const:Nn \c__lc_name_regex { \A [A-Za-z] [A-Za-z0-9]* '* \Z } % what counts as a variable name
\regex_const:Nn \c__lc_letter_regex { \A [a-z] \Z } % single lowercase letter, the built-in variables
\cs_generate_variant:Nn \regex_match:NnT { Ne } % match against an expanded subject
\prg_new_protected_conditional:Npnn \__lc_if_keys:n #1 { F } % a key list has a `=' or a comma
  {
    \tl_if_in:nnTF {#1} { = }
      { \prg_return_true: }
      { \tl_if_in:nnTF {#1} { , } { \prg_return_true: } { \prg_return_false: } }
  }
\cs_new_protected:Npn \lc@base@opt #1 % the optional argument of a term: color start or keys
  {
    \tl_set:Nn \l__lc_tmp_tl {#1}
    \__lc_if_keys:nF {#1} { \tl_set:Ne \l__lc_tmp_tl {#1} }
    \exp_args:NNV \regex_match:NnTF \c__lc_number_regex \l__lc_tmp_tl
      { \tl_set_eq:NN \l__lc_color_tl \l__lc_tmp_tl }
      { \tl_set:Nn \l__lc_color_tl { 0 } \lcSetup {#1} }
    \exp_args:NV \lc@enable@base \l__lc_color_tl
  }
\cs_new_protected:Npn \lc@checkvarname % guards the named-variable form against bad names
  {
    \__lc_if_var_name:VTF \lc@name
      { \exp_args:NV \lc@var \lc@name }
      { \msg_error:nnV { lc-visualizer } { bad-name } \lc@name }
  }
\cs_new_protected:Npn \lc@checkrulename #1 % a rule must not shadow a single-letter variable
  { \regex_match:NeT \c__lc_letter_regex {#1} { \msg_error:nne { lc-visualizer } { rule-name } {#1} } }
\regex_const:Nn \c__lc_alnum_regex { \A [A-Za-z0-9] \Z } % one letter or digit, used to read words
\regex_const:Nn \c__lc_digits_regex { \A [0-9]+ \Z } % a bare number, typeset as a constant
\regex_const:Nn \c__lc_numeral_regex { \A \\ \. \\ \. ( \( \[2\] \  )* \[1\] \)* \Z } % a de Bruijn church numeral, for folding
\regex_const:Nn \c__lc_number_regex { \A \s* \+? \d+ \s* \Z } % an integer rule argument

\bool_new:N \g__lc_error_bool % set when an error happened, blocks caching
\cs_new_protected:Npn \__lc_error:nn { \bool_gset_true:N \g__lc_error_bool \msg_error:nn } % error that also marks the run as failed
\cs_new_protected:Npn \__lc_error:nnn { \bool_gset_true:N \g__lc_error_bool \msg_error:nnn }
\cs_generate_variant:Nn \__lc_error:nnn { nne , nnV }
\msg_new:nnn { lc-visualizer } { no-beamer } % beamer keys asked for outside of beamer
  { The~option~beamer~only~works~in~beamer~documents. }
\msg_new:nnn { lc-visualizer } { cache-shared } % two reductions writing the same cache file
  { The~cache~file~`#1'~is~used~by~different~reductions. }
\msg_new:nnn { lc-visualizer } { negative-steps } % max-steps below zero
  { max-steps~must~not~be~negative~(got~`#1'). }
\msg_new:nnn { lc-visualizer } { tooltips } % tooltips need a pdf-producing engine
  { The~option~tooltips~needs~pdfTeX~or~LuaTeX. }
\msg_new:nnn { lc-visualizer } { cache-foreign } % refuse to clobber a file we did not write
  { Refusing~to~overwrite~`#1',~which~is~no~cache~file~of~lc-visualizer. }
\msg_new:nnn { lc-visualizer } { unknown-fold } % fold asked for a rule that does not exist
  { Unknown~rule~`#1'~for~fold~(give~the~name~of~its~macro,~without~argument). }
\msg_new:nnn { lc-visualizer } { unbalanced } % leftover input after parsing a term
  { Unbalanced~parentheses~in~lambda~term~`#1'. }
\msg_new:nnn { lc-visualizer } { missing-paren } % a group was opened but never closed
  { Missing~`)'~in~lambda~term. }
\msg_new:nnn { lc-visualizer } { empty } % nothing to parse where a term was expected
  { Empty~lambda~term~(or~abstraction~without~body). }
\msg_new:nnn { lc-visualizer } { bad-name } % a variable name that is no legal name
  { `#1'~is~no~variable~name~(letters~and~digits~starting~with~a~letter,~optionally~followed~by~primes). }
\msg_new:nnn { lc-visualizer } { rule-name } % a rule name that collides with a variable
  { `#1'~is~the~variable~`#1'~and~cannot~name~a~rewriting~rule;~use~a~longer~name. }
\msg_new:nnn { lc-visualizer } { bad-number } % a numeric rule argument that is no integer
  { `#1'~is~no~integer. }
\msg_new:nnn { lc-visualizer } { missing-argument } % a rule with an argument was used without one
  { The~rewriting~rule~`#1'~needs~an~argument. }
\msg_new:nnn { lc-visualizer } { recursive-rule } % a rule that unfolds into itself
  { The~rewriting~rule~`#1'~uses~itself~and~cannot~be~unfolded. }
\msg_new:nnn { lc-visualizer } { missing-dot } % binders not followed by the dot
  { Missing~`.'~after~the~binders~of~an~abstraction. }
\msg_new:nnn { lc-visualizer } { unexpected } % a token that cannot start an atom
  { Unexpected~`#1'~in~lambda~term. }
\msg_new:nnn { lc-visualizer } { max-steps } % reduction stopped before a normal form
  { Stopped~reducing~after~#1~steps~without~reaching~a~normal~form~(increase~max-steps~if~there~is~one). }

\cs_new:Npn \__lc_kind:n #1 { \__lc_kind_aux:nnn #1 } % the tag of a term: v, l, a or c
\cs_new:Npn \__lc_kind_aux:nnn #1#2#3 { \exp_not:n {#1} } % picks the tag out of the triple

\cs_new_protected:Npn \__lc_trim: { \tl_gtrim_spaces:N \g__lc_in_tl } % drop leading spaces of the parser input
\cs_new_protected:Npn \__lc_pop: { \tl_gset:Nx \g__lc_in_tl { \tl_tail:N \g__lc_in_tl } } % consume the token at the front of the input
\cs_new_protected:Npn \__lc_head: { \tl_set:Nx \l__lc_head_tl { \tl_head:N \g__lc_in_tl } } % look at the front of the input without consuming

\prg_new_protected_conditional:Npnn \__lc_if_head_str:n #1 { T, F, TF } % is the next token this character
  {
    \tl_if_empty:NTF \g__lc_in_tl
      { \prg_return_false: }
      {
        \exp_args:NV \tl_if_head_is_N_type:nTF \g__lc_in_tl
          {
            \__lc_head:
            \str_if_eq:eeTF { \exp_after:wN \token_to_str:N \l__lc_head_tl } {#1}
              { \prg_return_true: } { \prg_return_false: }
          }
          { \prg_return_false: }
      }
  }

\cs_new_protected:Npn \__lc_if_either:nnTF #1#2#3#4 % is the next token one of two characters
  { \__lc_if_head_str:nTF {#1} {#3} { \__lc_if_head_str:nTF {#2} {#3} {#4} } }

\prg_new_protected_conditional:Npnn \__lc_if_var_name:n #1 { T, F, TF } % is this string a legal variable name
  { \regex_match:NnTF \c__lc_name_regex {#1} { \prg_return_true: } { \prg_return_false: } }
\cs_generate_variant:Nn \__lc_if_var_name:nTF { V } % test on a variable holding the name
\cs_generate_variant:Nn \__lc_if_var_name:nF { V }
\cs_generate_variant:Nn \tl_trim_spaces:n { o } % trim a once-expanded argument
\cs_new:Npn \lc@trim #1 { \tl_trim_spaces:o {#1} } % user-level trimming of a name

\cs_new:Npn \__lc_name:n #1 % the name of a token, control sequence or not
  {
    \tl_if_single_token:nTF {#1}
      { \token_if_cs:NTF #1 { \cs_to_str:N #1 } { \tl_to_str:n {#1} } }
      { \tl_to_str:n {#1} }
  }

\cs_new_protected:Npn \__lc_parse:nN #1#2 % parse a lambda term into the triple form
  {
    \group_begin:
      \tl_set_eq:NN \l__lc_saved_in_tl \g__lc_in_tl
      \tl_gset:Nn \g__lc_in_tl {#1}
      \__lc_parse_seq:
      \__lc_trim:
      \tl_if_empty:NF \g__lc_in_tl
        { \__lc_error:nne { lc-visualizer } { unbalanced } { \tl_to_str:n {#1} } }
      \tl_gset_eq:NN \g__lc_in_tl \l__lc_saved_in_tl
    \group_end:
    \tl_set_eq:NN #2 \g__lc_ret_tl
  }
\cs_generate_variant:Nn \__lc_parse:nN { V , e } % parse from a variable or an expanded argument

\cs_new_protected:Npn \__lc_parse_seq: % a sequence of atoms, applied left to right
  {
    \group_begin:
      \tl_clear:N \l__lc_acc_tl
      \bool_set_true:N \l__lc_continue_bool
      \bool_while_do:Nn \l__lc_continue_bool { \__lc_parse_atom: }
      \tl_if_empty:NT \l__lc_acc_tl
        {
          \__lc_error:nn { lc-visualizer } { empty }
          \tl_set:Nn \l__lc_acc_tl { {c}{}{} }
        }
      \tl_gset_eq:NN \g__lc_ret_tl \l__lc_acc_tl
    \group_end:
  }

\cs_new_protected:Npn \__lc_push: % apply what was just parsed to what came before
  {
    \tl_if_empty:NTF \l__lc_acc_tl
      { \tl_set_eq:NN \l__lc_acc_tl \g__lc_ret_tl }
      { \tl_set:Nx \l__lc_acc_tl { {a} { \exp_not:V \l__lc_acc_tl } { \exp_not:V \g__lc_ret_tl } } }
  }

\cs_new_protected:Npn \__lc_parse_atom: % one atom: group, variable, lambda or constant
  {
    \__lc_trim:
    \tl_if_empty:NTF \g__lc_in_tl
      { \bool_set_false:N \l__lc_continue_bool }
      {
        \exp_args:NV \tl_if_head_is_group:nTF \g__lc_in_tl
          {
            \__lc_head:
            \__lc_pop:
            \__lc_parse:VN \l__lc_head_tl \l__lc_head_tl
            \tl_gset_eq:NN \g__lc_ret_tl \l__lc_head_tl
            \__lc_push:
          }
          {
            \__lc_head:
            \exp_last_unbraced:NV \__lc_parse_token:N \l__lc_head_tl
          }
      }
  }

\cs_new_protected:Npn \__lc_parse_token:N #1 % dispatch on the token that starts an atom
  {
    \token_if_cs:NTF #1
      {
        \str_set:Nx \l__lc_name_str { \cs_to_str:N #1 }
        \str_case:VnF \l__lc_name_str
          {
            { ( } { \__lc_pop: \__lc_parse_paren: }
            { ) } { \bool_set_false:N \l__lc_continue_bool }
            { [ } { \__lc_pop: \__lc_parse_list: }
            { . } { \__lc_error:nne { lc-visualizer } { unexpected } { \c_backslash_str . } \__lc_pop: }
            { mark } { \__lc_pop: \__lc_parse_mark: }
            { lcListOf } { \__lc_pop: \__lc_parse_list_arg: }
            { lcVar } { \__lc_pop: \__lc_parse_named_var: }
            { RLC } { \__lc_pop: \__lc_skip_optional: }
            { LC } { \__lc_pop: \__lc_skip_optional: }
            { lc@argument } { \__lc_pop: \str_set:Nn \l__lc_name_str { @ } \__lc_push_var: }
            { ~ } { \__lc_pop: }
            { , } { \__lc_pop: }
            { ; } { \__lc_pop: }
            { quad } { \__lc_pop: }
          }
          {
            \str_if_eq:NNTF \l__lc_name_str \c__lc_bs_str
              { \__lc_pop: \__lc_parse_lambda: }
              {
                \regex_match:NVTF \c__lc_letter_regex \l__lc_name_str
                  { \__lc_take_var: }
                  {
                    % a name of \lcEnableChar is a variable as well, every other macro is a constant
                    \cs_if_exist:cTF { lc@enabled@ \l__lc_name_str }
                      { \__lc_take_var: }
                      { \__lc_pop: \__lc_parse_const:N #1 }
                  }
              }
          }
      }
      {
        \str_set:Nx \l__lc_name_str { \token_to_str:N #1 }
        \str_case:VnF \l__lc_name_str
          {
            { ( } { \__lc_pop: \__lc_parse_paren: }
            { ) } { \bool_set_false:N \l__lc_continue_bool }
            { [ } { \__lc_pop: \__lc_parse_list: }
            { . } { \__lc_error:nnn { lc-visualizer } { unexpected } { . } \__lc_pop: }
            { * } { \__lc_error:nnn { lc-visualizer } { unexpected } { * } \__lc_pop: }
          }
          {
            \__lc_pop:
            \str_if_eq:NNF \l__lc_name_str \c_tilde_str
              {
                \__lc_word:
                \__lc_if_var_name:VTF \l__lc_name_str
                  { \__lc_primes: \__lc_push_var: }
                  {
                    \regex_match:NVTF \c__lc_digits_regex \l__lc_name_str
                      { \tl_gset:Nx \g__lc_ret_tl { {c} { \l__lc_name_str } {} } \__lc_push: }
                      { \__lc_parse_char_const:N #1 }
                  }
              }
          }
      }
  }
\cs_new_protected:Npn \__lc_parse_char_const:N #1 % a character that is no variable becomes a constant
  {
    \tl_set:Nn \l__lc_tmp_tl {#1}
    \str_if_eq:VnTF \l__lc_name_str { $ }
      { \__lc_take_until_dollar: }
      {
        \token_if_active:NT #1
          {
            \int_compare:nNnT { `#1 } > { 191 }
              {
                \prg_replicate:nn
                  { \int_compare:nNnTF { `#1 } > { 239 } { 3 } { \int_compare:nNnTF { `#1 } > { 223 } { 2 } { 1 } } }
                  { \__lc_take_one: }
              }
          }
      }
    \tl_gset:Nx \g__lc_ret_tl { {c} { \exp_not:V \l__lc_tmp_tl } {} }
    \__lc_push:
  }
\cs_new_protected:Npn \__lc_word: % read the rest of a multi-letter name
  { \regex_match:NVT \c__lc_alnum_regex \l__lc_name_str { \__lc_word_loop: } }
\cs_new_protected:Npn \__lc_word_loop: % keep taking letters and digits of the name
  {
    \exp_args:NV \tl_if_head_is_N_type:nT \g__lc_in_tl
      {
